{
  "info": {
    "name": "Genoa Golf Club API",
    "_postman_id": "b5a25111-demo-ggc",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Events",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Venue Enquiry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Demo Guest\",\n  \"email\": \"demo@example.com\",\n  \"phone\": \"555-0100\",\n  \"eventType\": \"Wedding\",\n  \"preferredDate\": \"2026-10-15\",\n  \"guestCount\": 120,\n  \"preferredVenue\": \"Either/Both\",\n  \"notes\": \"Postman demo request\",\n  \"referralSource\": \"Google\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/venue-enquiries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "venue-enquiries"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Enquiry id exists', () => pm.expect(pm.response.json().enquiryId).to.exist);"
            ]
          }
        }
      ]
    }
  ]
}